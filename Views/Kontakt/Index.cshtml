@model PrijavaIspita.Models.KontaktPoruka
@{
    ViewData["Title"] = "Kontakt";
}

<div class="container mt-5">
    <div class="row g-4">

        <!-- LEVA STRANA -->
        <div class="col-md-6">
            <h3 class="mb-3">Kontakt informacije</h3>
            <div class="p-3 bg-white shadow-sm rounded">
                <p><strong>📍 Adresa:</strong><br />Savski nasip 7, Beograd</p>
                <p><strong>📞 Telefon:</strong><br />+381 11 123 4567</p>
                <p><strong>✉ Email:</strong><br />info@its.edu.rs</p>

                <div class="mt-3 mb-3 rounded overflow-hidden shadow-sm">
                    <iframe src="https://www.google.com/maps?q=Savski%20nasip%207%20Beograd&output=embed"
                            width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>

                <div class="mt-2">
                    <a href="https://www.facebook.com/ITSBeograd" target="_blank" class="me-3">
                        <img src="~/img/facebook.png" width="32" alt="Facebook" />
                    </a>
                    <a href="https://www.instagram.com/itsbeograd/" target="_blank" class="me-3">
                        <img src="~/img/instagram.png" width="32" alt="Instagram" />
                    </a>
                </div>
            </div>
        </div>

        <!-- DESNA STRANA -->
        <div class="col-md-6">
            <h3 class="mb-3">Kontakt forma</h3>
            <div class="p-3 bg-white shadow-sm rounded">

                @if (TempData["Uspesno"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Uspesno"]
                    </div>
                }

                <form method="post" asp-action="PosaljiPoruku">
                    <div class="mb-3">
                        <label class="form-label">Ime i prezime</label>
                        <input type="text" name="Ime" class="form-control" placeholder="Ime i prezime" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email adresa</label>
                        <input type="email" name="Email" class="form-control" placeholder="E-mail" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Poruka</label>
                        <textarea name="Poruka" class="form-control" rows="5" placeholder="Vaša poruka" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Pošalji poruku
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>
