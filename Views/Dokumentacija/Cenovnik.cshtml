@{
    ViewData["Title"] = "Cenovnik";
}

<div class="mb-4 text-center">
    <h2>Cenovnik usluga</h2>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-striped text-center mb-0">
        <thead class="table-danger">
            <tr>
                <th>Usluga</th>
                <th>Cena (EUR)</th>
                <th>Napomena</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Prijava ispita (druga)</td>
                <td>15</td>
                <td>Prva prijava ispita je besplatna, druga prijava ispita je 15 eur (ne važi za paket Ekskluziv) do početka nove studijske godine.</td>
            </tr>
            <tr>
                <td>Prijava ispita (treća i svaka naredna)</td>
                <td>25</td>
                <td>Treća i svaka sledeća prijava ispita je 25 eur (ne važi za paket Ekskluziv) do početka nove studijske godine.</td>
            </tr>
            <tr>
                <td>Kašnjenje prijave ispita</td>
                <td>15</td>
                <td>Podrazumeva vremensko kašnjenje na koje se dodaje cena prijave ispita u zavisnosti od broja prijavljivanja.</td>
            </tr>
            <tr>
                <td>Polaganje prijemnog ispita</td>
                <td>40</td>
                <td></td>
            </tr>
            <tr>
                <td>Izdavanje osnovnih potvrda o statusu studenta, bez naknade</td>
                <td>0</td>
                <td></td>
            </tr>
            <tr>
                <td>Izdavanje drugih nestandardnih potvrda i uverenja na engleskom jeziku +100%</td>
                <td>15</td>
                <td>Potvrde: korišćenja Fitpass usluge, apliciranja za Work and Travel program</td>
            </tr>
            <tr>
                <td>Izdavanje duplikata indeksa</td>
                <td>50</td>
                <td></td>
            </tr>
            <tr>
                <td>Poništavanje ispita</td>
                <td>20</td>
                <td></td>
            </tr>
            <tr>
                <td>Dodatak diplome na engleskom jeziku</td>
                <td>50</td>
                <td></td>
            </tr>
            <tr>
                <td>Promena izbornog predmeta</td>
                <td>20</td>
                <td></td>
            </tr>
            <tr>
                <td>Završni / master rad</td>
                <td>200</td>
                <td>
                    U cenu završnog rada/master rada je uračunato:<br />
                    - Prijava završnog rada/master rada<br />
                    - Rad sa mentorom tokom izrade rada<br />
                    - Rad komisije i odbrana završnog rada/master rada<br />
                    - Izdavanje uverenja o sticanju zvanja nakon uspešne odbrane<br />
                    - Izdavanje i popunjavanje diplome na srpskom jeziku<br />
                    - Snimak odbrane završnog/master rada<br />
                    - Izdavanje i popunjavanje dodatka diplome na srpskom jeziku.
                </td>
            </tr>
            <tr>
                <td>Naknada za produžetak roka studiranja</td>
                <td>100</td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>
