@model PrijavaIspita.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-sm p-4" style="width: 400px; border-radius: 10px;">
        <h3 class="text-center mb-4" style="color: var(--primary-color);">Studentski portal</h3>

        <form asp-action="Login" method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group position-relative mb-3">
                <i class="fas fa-envelope input-icon"></i>
                <input asp-for="Email" class="form-control form-with-icon" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group position-relative mb-3">
                <i class="fas fa-lock input-icon"></i>
                <input asp-for="Password" type="password" class="form-control form-with-icon" placeholder="Lozinka" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-hover">Login</button>

            <div class="text-center mt-3">
                <small>
                    Nemate nalog?
                    <a asp-controller="Account" asp-action="Register" style="color: var(--primary-color); text-decoration: underline;">
                        Registrujte se
                    </a>
                </small>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
