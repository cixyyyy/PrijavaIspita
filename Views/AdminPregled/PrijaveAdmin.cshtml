@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<PrijavaIspita.Models.PrijavaIspitaBO>

<h2 class="mb-4 text-center">Prijave studenata</h2>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-striped text-center mb-0">
        <thead class="table-danger">
            <tr>
                <th>Predmet</th>
                <th>Student</th>
                <th>Ocena</th>
                <th>Rok</th>
                <th>Datum prijave</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Predmet.Naziv</td>
                    <td>@item.Korisnik.ImePrezime</td>
                    <td>@item.Ocena</td>
                    <td>@item.Rok</td>
                    <td>@item.DatumPrijave.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="mt-3 d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("PrijaveAdmin", new { page }), new PagedListRenderOptions
   {
       LiElementClasses = new[] { "page-item" },
       PageClasses = new[] { "page-link" }
   })
    </div>

</div>
