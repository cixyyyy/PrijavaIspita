@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<PrijavaIspita.Models.TransakcijaBO>

<h2 class="mb-4 text-center">Finansijske transakcije</h2>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-striped text-center mb-0">
        <thead class="table-danger">
            <tr>
                <th>Student</th>
                <th>Email</th>
                <th>Tip</th>
                <th>Iznos</th>
                <th>Datum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Korisnik.ImePrezime</td>
                    <td>@t.Korisnik.Email</td>
                    <td>@t.Tip</td>
                    <td>@t.Iznos</td>
                    <td>@t.Datum.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3 d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("TransakcijeAdmin", new { page }), new PagedListRenderOptions
   {
       LiElementClasses = new[] { "page-item" },
       PageClasses = new[] { "page-link" }
   })
    </div>
</div>
