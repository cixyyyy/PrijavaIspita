@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<PrijavaIspita.Models.ObavestenjeBO>
@{
    ViewData["Title"] = "Obaveštenja";
}

<h2 class="mb-4 text-center">Vaša obaveštenja</h2>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">Nemate novih obaveštenja.</div>
}
else
{
    <ul class="list-group mb-3 shadow-sm">
        @foreach (var o in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center rounded mb-2 shadow-sm">
                <span>@o.Tekst</span>
                <small class="text-muted">@o.Datum.ToString("dd.MM.yyyy HH:mm")</small>
            </li>
        }
    </ul>

    <div class="d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
                new PagedListRenderOptions
    {
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" },
        UlElementClasses = new[] { "pagination" }
    })
    </div>
}
